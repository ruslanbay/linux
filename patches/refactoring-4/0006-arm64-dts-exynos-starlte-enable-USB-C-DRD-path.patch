From a41ac1ce5cc52b989323dc8716fdff3db76abb3b Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 9 Mar 2026 17:35:18 +0000
Subject: [PATCH 6/6] arm64: dts: exynos: starlte: enable USB-C DRD path

---
 .../boot/dts/exynos/exynos9810-starlte.dts    | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9810-starlte.dts b/arch/arm64/boot/dts/exynos/exynos9810-starlte.dts
index 2b948fb659..17872c8206 100644
--- a/arch/arm64/boot/dts/exynos/exynos9810-starlte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9810-starlte.dts
@@ -11,6 +11,7 @@
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/usb/pd.h>
 
 / {
 	model = "Samsung Galaxy S9 (SM-G960F)";
@@ -222,6 +223,30 @@ &mmc {
 	status = "okay";
 };
 
+&usbdrd {
+	status = "okay";
+};
+
+&usbdrd_dwc3 {
+	status = "okay";
+	dr_mode = "otg";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	connector {
+		compatible = "usb-c-connector";
+		label = "USB-C";
+		data-role = "dual";
+		power-role = "dual";
+		try-power-role = "sink";
+		source-pdos = <PDO_FIXED(5000, 900,
+					 (PDO_FIXED_SUSPEND | PDO_FIXED_USB_COMM |
+					  PDO_FIXED_DATA_SWAP | PDO_FIXED_DUAL_ROLE))>;
+		pinctrl-names = "default";
+		status = "disabled";
+	};
+};
+
 &pinctrl_alive {
 	key_power: key-power-pins {
 		samsung,pins = "gpa2-4";
-- 
